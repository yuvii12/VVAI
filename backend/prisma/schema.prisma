datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. AUTH & RBAC
// ----------------------------------------------------

model User {
  id           String    @id @default(uuid())
  employeeCode String    @unique @map("employee_code") // e.g. ADM-000001, EMP-000001
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  roleId       String    @map("role_id")
  department   String?
  branch       String?
  city         String?
  status       String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  role         Role      @relation(fields: [roleId], references: [id])
  sessions     Session[]
  auditLogs    AuditLog[]
  employee     Employee?

  @@index([email])
  @@index([roleId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // ADMIN, SALES_EMPLOYEE, MANAGER, AUDITOR
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. crm.leads.read, gst.rules.manage, audit.view
  name        String
  module      String   // CRM, ERP, INVENTORY, PRICING, GST, USERS, AUDIT
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ----------------------------------------------------
// 2. GEOGRAPHY & LOCATIONS
// ----------------------------------------------------

model State {
  id        String   @id @default(uuid())
  name      String   @unique // Bihar, Jharkhand, West Bengal, Odisha, Uttar Pradesh
  code      String   @unique // BR, JH, WB, OD, UP
  createdAt DateTime @default(now()) @map("created_at")

  cities    City[]
  projects  Project[]

  @@map("states")
}

model City {
  id             String   @id @default(uuid())
  stateId        String   @map("state_id")
  name           String   // Patna, Ranchi, Bhagalpur, etc.
  normalizedName String   @map("normalized_name") // patna, ranchi, bhagalpur
  isMetro        Boolean  @default(false) @map("is_metro")
  createdAt      DateTime @default(now()) @map("created_at")

  state          State    @relation(fields: [stateId], references: [id])
  locations      Location[]
  sites          Site[]
  projects       Project[]

  @@unique([stateId, normalizedName])
  @@index([normalizedName])
  @@map("cities")
}

model MetroCity {
  id        String   @id @default(uuid())
  cityName  String   @unique @map("city_name")
  stateName String   @map("state_name")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("metro_cities")
}

model Location {
  id        String   @id @default(uuid())
  cityId    String   @map("city_id")
  name      String
  landmark  String?
  pincode   String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now()) @map("created_at")

  city      City     @relation(fields: [cityId], references: [id])

  @@map("locations")
}

model Site {
  id        String   @id @default(uuid())
  cityId    String   @map("city_id")
  name      String
  address   String
  landmark  String?
  pincode   String?
  phones    String?  // JSON string or comma-separated
  sourceUrl String?  @map("source_url")
  createdAt DateTime @default(now()) @map("created_at")

  city      City     @relation(fields: [cityId], references: [id])

  @@map("sites")
}

// ----------------------------------------------------
// 3. PROJECTS & PHASES
// ----------------------------------------------------

model Project {
  id            String   @id @default(uuid())
  name          String   // e.g. "Vastu Vihar Patna"
  code          String   @unique
  stateId       String   @map("state_id")
  cityId        String   @map("city_id")
  projectType   String   @default("Residential") @map("project_type") // Residential, Commercial, Mixed
  status        String   @default("Ongoing") // Ongoing, Under Construction, Completed, New Launch, Upcoming
  reraNumber    String?  @map("rera_number")
  reraStatus    String?  @map("rera_status")
  totalUnits    Int      @default(0) @map("total_units")
  siteAddress   String   @map("site_address")
  officeAddress String?  @map("office_address")
  officePhone   String?  @map("office_phone")
  officeEmail   String?  @map("office_email")
  landmark      String?
  pincode       String?
  latitude      Float?
  longitude     Float?
  imageUrl      String?  @map("image_url")
  sourceUrl     String?  @map("source_url")
  sourceDate    String?  @map("source_date")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  state         State    @relation(fields: [stateId], references: [id])
  city          City     @relation(fields: [cityId], references: [id])
  phases        ProjectPhase[]
  properties    Property[]
  propertyUnits PropertyUnit[]

  @@index([cityId])
  @@index([stateId])
  @@index([status])
  @@map("projects")
}

model ProjectPhase {
  id                 String   @id @default(uuid())
  projectId          String   @map("project_id")
  phaseName          String   @map("phase_name") // e.g. "PH-01", "PH-03"
  phaseNumber        Int?     @map("phase_number")
  status             String   @default("Ongoing") // Ongoing, Under Construction, Completed, Sold Out
  totalUnits         Int      @default(0) @map("total_units")
  availableUnits     Int      @default(0) @map("available_units")
  bookedUnits        Int      @default(0) @map("booked_units")
  soldUnits          Int      @default(0) @map("sold_units")
  constructionStatus String?  @map("construction_status")
  possessionDate     String?  @map("possession_date")
  reraNumber         String?  @map("rera_number")
  siteAddress        String   @map("site_address")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  properties         Property[]
  propertyUnits      PropertyUnit[]

  @@unique([projectId, phaseName])
  @@index([phaseName])
  @@index([status])
  @@map("project_phases")
}

// ----------------------------------------------------
// 4. PROPERTY TYPES, MODELS & SPECIFICATIONS
// ----------------------------------------------------

model PropertyType {
  id          String   @id @default(uuid())
  name        String   @unique // 1 BHK, 2 BHK, 3 BHK, 4 BHK, 5 BHK, Duplex, Bungalow, Villa, Commercial, Plot
  category    String   // Residential, Commercial, Land
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  properties  Property[]

  @@map("property_types")
}

model Property {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  phaseId          String?  @map("phase_id")
  propertyTypeId   String   @map("property_type_id")
  modelName        String   @map("model_name") // e.g. "Yamuna Standard Plan", "Business Bungalow", "Ananta Bungalow", "Jayanti Standard Bungalow", "CEO Bungalow"
  bhk              Int?
  plotSize         String?  @map("plot_size") // e.g. "40' x 40'", "24 x 45"
  plotArea         Float?   @map("plot_area") // in sq.ft
  builtUpArea      Float?   @map("built_up_area") // in sq.ft
  carpetArea       Float?   @map("carpet_area") // in sq.ft
  floors           String?  // e.g. "G+1", "G+1 + Rooftop"
  configuration    String?  // e.g. "5 BHK | G+1 with Rooftop Amenities"
  roomDimensions   String?  @map("room_dimensions") // JSON string of exact room dimensions
  setbacks         String?  // JSON string: front, rear, left, right
  rooftopAmenities String?  @map("rooftop_amenities") // JSON string of gym, pool, gazebo, etc.
  deluxeSpecs      String?  @map("deluxe_specs") // JSON string from PDF 1
  luxurySpecs      String?  @map("luxury_specs") // JSON string from PDF 1
  basePrice        Float?   @map("base_price")
  status           String   @default("Available")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase            ProjectPhase? @relation(fields: [phaseId], references: [id])
  propertyType     PropertyType @relation(fields: [propertyTypeId], references: [id])
  units            PropertyUnit[]
  propertyAmenities PropertyAmenity[]

  @@index([propertyTypeId])
  @@index([modelName])
  @@map("properties")
}

model PropertyUnit {
  id            String   @id @default(uuid())
  propertyId    String   @map("property_id")
  projectId     String   @map("project_id")
  phaseId       String?  @map("phase_id")
  unitNumber    String   @map("unit_number") // e.g. "A-101", "B-204"
  floor         Int?
  facing        String?  // North, East, South, West
  status        String   @default("Available") // Available, Booked, Sold, On Hold
  bookingStatus String?  @map("booking_status")
  erpUnitId     String?  @unique @map("erp_unit_id")
  currentPrice  Float?   @map("current_price")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  project       Project      @relation(fields: [projectId], references: [id])
  phase         ProjectPhase? @relation(fields: [phaseId], references: [id])

  @@index([status])
  @@index([projectId])
  @@map("property_units")
}

model Amenity {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String   // Recreation, Security, Eco, Wellness
  description String?
  icon        String?
  isDeluxe    Boolean  @default(true) @map("is_deluxe")
  isLuxury    Boolean  @default(true) @map("is_luxury")
  createdAt   DateTime @default(now()) @map("created_at")

  propertyAmenities PropertyAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  amenityId  String   @map("amenity_id")

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
  @@map("property_amenities")
}

// ----------------------------------------------------
// 5. PRICING & PRICE LISTS
// ----------------------------------------------------

model PriceList {
  id                String    @id @default(uuid())
  stateId           String    @map("state_id")
  cityId            String    @map("city_id")
  projectId         String?   @map("project_id")
  phaseId           String?   @map("phase_id")
  propertyTypeId    String    @map("property_type_id")
  bhk               Int?
  unitType          String?   @map("unit_type") // Flat, Duplex, Bungalow, Penthouse
  basePrice         Float     @map("base_price")
  developmentCharge Float     @default(0) @map("development_charge")
  parkingCharge     Float     @default(0) @map("parking_charge")
  otherCharges      Float     @default(0) @map("other_charges")
  gstRate           Float     @default(0.01) @map("gst_rate") // e.g. 0.01 for 1%, 0.05 for 5%
  totalPrice        Float     @map("total_price")
  effectiveFrom     DateTime  @map("effective_from")
  effectiveTo       DateTime? @map("effective_to")
  sourceDocument    String?   @map("source_document")
  status            String    @default("ACTIVE") // ACTIVE, SUPERSEDED, DRAFT
  createdAt         DateTime  @default(now()) @map("created_at")

  priceHistories    PriceHistory[]

  @@index([cityId, propertyTypeId, bhk])
  @@index([status])
  @@map("price_lists")
}

model PriceHistory {
  id          String   @id @default(uuid())
  priceListId String   @map("price_list_id")
  oldPrice    Float    @map("old_price")
  newPrice    Float    @map("new_price")
  changedBy   String?  @map("changed_by")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@map("price_history")
}

// ----------------------------------------------------
// 6. CRM & SALES
// ----------------------------------------------------

model CrmCustomer {
  id                    String   @id @default(uuid())
  externalId            String?  @unique @map("external_id")
  name                  String
  phone                 String
  email                 String?
  cityId                String?  @map("city_id")
  interestedProjectId   String?  @map("interested_project_id")
  interestedPropertyType String? @map("interested_property_type")
  bhkPreference         Int?     @map("bhk_preference")
  budget                Float?
  status                String   @default("ACTIVE")
  assignedEmployeeId    String?  @map("assigned_employee_id")
  source                String?  // Website, Walk-in, Call Center, Referral
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  leads                 CrmLead[]
  interactions          CrmInteraction[]
  siteVisits            SiteVisit[]
  bookings              Booking[]

  @@index([phone])
  @@index([name])
  @@map("crm_customers")
}

model CrmLead {
  id               String    @id @default(uuid())
  externalId       String?   @unique @map("external_id")
  customerId       String    @map("customer_id")
  stage            String    @default("New") // New, Contacted, Site Visit Scheduled, Negotiation, Won, Lost
  score            Int       @default(50)
  budget           Float?
  bhk              Int?
  preferredCity    String?   @map("preferred_city")
  preferredProject String?   @map("preferred_project")
  assignedToId     String?   @map("assigned_to_id")
  nextFollowupDate DateTime? @map("next_followup_date")
  status           String    @default("OPEN") // OPEN, CLOSED
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  customer         CrmCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  followups        CrmFollowup[]

  @@index([stage])
  @@index([assignedToId])
  @@map("crm_leads")
}

model CrmInteraction {
  id              String   @id @default(uuid())
  customerId      String   @map("customer_id")
  leadId          String?  @map("lead_id")
  employeeId      String?  @map("employee_id")
  interactionType String   @map("interaction_type") // Call, WhatsApp, Email, Site Visit, Meeting
  notes           String
  timestamp       DateTime @default(now())

  customer        CrmCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("crm_interactions")
}

model CrmFollowup {
  id            String    @id @default(uuid())
  leadId        String    @map("lead_id")
  customerId    String?   @map("customer_id")
  employeeId    String?   @map("employee_id")
  scheduledDate DateTime  @map("scheduled_date")
  status        String    @default("Pending") // Pending, Completed, Cancelled
  outcome       String?
  createdAt     DateTime  @default(now()) @map("created_at")

  lead          CrmLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("crm_followups")
}

model SiteVisit {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  projectId  String   @map("project_id")
  phaseId    String?  @map("phase_id")
  propertyId String?  @map("property_id")
  employeeId String?  @map("employee_id")
  visitDate  String   @map("visit_date")
  visitTime  String   @map("visit_time")
  status     String   @default("Scheduled") // Scheduled, Confirmed, Completed, Cancelled, No Show
  notes      String?
  feedback   String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer   CrmCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("site_visits")
}

model Booking {
  id             String   @id @default(uuid())
  bookingNumber  String   @unique @map("booking_number")
  customerId     String   @map("customer_id")
  projectId      String   @map("project_id")
  phaseId        String?  @map("phase_id")
  unitId         String?  @map("unit_id")
  employeeId     String?  @map("employee_id")
  basePrice      Float    @map("base_price")
  gstAmount      Float    @map("gst_amount")
  discountAmount Float    @default(0) @map("discount_amount")
  totalAmount    Float    @map("total_amount")
  paymentPlan    String?  @map("payment_plan") // Construction Linked, Down Payment, Custom
  bookingStatus  String   @default("Confirmed") // Confirmed, Pending Payment, Cancelled, Completed
  bookingDate    DateTime @default(now()) @map("booking_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  customer       CrmCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@map("bookings")
}

model Payment {
  id                   String   @id @default(uuid())
  bookingId            String   @map("booking_id")
  customerId           String   @map("customer_id")
  amount               Float
  paymentMode          String   @map("payment_mode") // Cheque, NEFT, RTGS, UPI, Cash
  transactionReference String?  @map("transaction_reference")
  status               String   @default("Completed") // Pending, Completed, Failed, Refunded
  paymentDate          DateTime @default(now()) @map("payment_date")
  receiptUrl           String?  @map("receipt_url")
  createdAt            DateTime @default(now()) @map("created_at")

  booking              Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Employee {
  id           String   @id @default(uuid())
  employeeCode String   @unique @map("employee_code")
  userId       String   @unique @map("user_id")
  department   String   // Sales, Operations, Accounts, CRM, Engineering
  designation  String
  branch       String
  phone        String
  joiningDate  String?  @map("joining_date")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employees")
}

// ----------------------------------------------------
// 7. GST ENGINE
// ----------------------------------------------------

model GstRule {
  id                String    @id @default(uuid())
  category          String    // residential, commercial
  metroApplicable   Boolean   @default(false) @map("metro_applicable")
  maxCarpetAreaSqm  Float?    @map("max_carpet_area_sqm") // e.g. 60 sqm for metro, 90 sqm for non-metro
  maxValueInr       Float?    @map("max_value_inr") // e.g. 4500000 (45 Lakh)
  conditionOperator String    @default("AND") @map("condition_operator") // AND, OR
  gstRatePct        Float     @map("gst_rate_pct") // 1.0 or 5.0
  effectiveFrom     DateTime  @map("effective_from")
  effectiveTo       DateTime? @map("effective_to")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("gst_rules")
}

model GstCalculation {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  cityId        String?  @map("city_id")
  isMetro       Boolean  @map("is_metro")
  propertyType  String   @map("property_type")
  carpetAreaSqm Float    @map("carpet_area_sqm")
  propertyValue Float    @map("property_value")
  basePrice     Float    @map("base_price")
  gstRatePct    Float    @map("gst_rate_pct")
  gstAmount     Float    @map("gst_amount")
  totalAmount   Float    @map("total_amount")
  appliedRuleId String?  @map("applied_rule_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("gst_calculations")
}

// ----------------------------------------------------
// 8. DOCUMENTS & KNOWLEDGE
// ----------------------------------------------------

model Document {
  id         String   @id @default(uuid())
  title      String
  fileName   String   @map("file_name")
  fileType   String   @map("file_type") // pdf, csv, xlsx, json, docx
  fileSize   Int      @map("file_size")
  filePath   String   @map("file_path")
  stateId    String?  @map("state_id")
  cityId     String?  @map("city_id")
  projectId  String?  @map("project_id")
  phaseId    String?  @map("phase_id")
  propertyId String?  @map("property_id")
  uploadedBy String?  @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("documents")
}

model KnowledgeDocument {
  id         String   @id @default(uuid())
  title      String
  sourceType String   @map("source_type")
  filePath   String   @map("file_path")
  status     String   @default("PROCESSED")
  createdAt  DateTime @default(now()) @map("created_at")

  chunks     KnowledgeChunk[]

  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  chunkIndex Int      @map("chunk_index")
  content    String
  metadata   String?  // JSON string
  createdAt  DateTime @default(now()) @map("created_at")

  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("knowledge_chunks")
}

model KnowledgeEntry {
  id            String   @id @default(uuid())
  title         String?
  category      String   // Pricing, Projects, Amenities, Company Overview, Booking, Legal, etc.
  state         String?
  city          String?
  project       String?
  phase         String?
  question      String
  answer        String
  keywords      String?  // JSON array string
  status        String   @default("confirmed") // confirmed, example_range, needs_confirmation
  sourceUrl     String?  @map("source_url")
  effectiveDate String?  @map("effective_date")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("knowledge_entries")
}

// ----------------------------------------------------
// 9. LOGS, SYNC & AUDIT
// ----------------------------------------------------

model ErpSyncLog {
  id               String    @id @default(uuid())
  syncType         String    @map("sync_type") // FULL, INVENTORY, PROJECTS, PRICING
  status           String    // SUCCESS, PARTIAL, FAILED
  recordsProcessed Int       @default(0) @map("records_processed")
  recordsInserted  Int       @default(0) @map("records_inserted")
  recordsUpdated   Int       @default(0) @map("records_updated")
  recordsFailed    Int       @default(0) @map("records_failed")
  errorDetails     String?   @map("error_details")
  triggeredBy      String?   @map("triggered_by")
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")

  @@map("erp_sync_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String   // LOGIN, VIEW_PAGE, QUERY_AI, SEARCH_CUSTOMER, EDIT_LEAD, SYNC_ERP, UPDATE_GST
  entity    String?  // Project, Lead, Customer, GstRule, Inventory
  entityId  String?  @map("entity_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  String?  // JSON string
  timestamp DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

model AiConversation {
  id        String      @id @default(uuid())
  userId    String?     @map("user_id")
  title     String      @default("New Conversation")
  language  String      @default("en") // en, hi, hinglish
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  messages  AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  sender         String   // user, assistant
  role           String   // user, assistant, system
  content        String
  intent         String?
  entities       String?  // JSON string
  sources        String?  // JSON string
  structuredData String?  @map("structured_data") // JSON string for cards
  createdAt      DateTime @default(now()) @map("created_at")

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
